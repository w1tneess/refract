          "engineLabel": "PDF renderer (mutool / pdftoppm / pdftocairo / gs)",
          "externalDependencies": ["mutool | pdftoppm | pdftocairo | gs"],
          "fallback": "Extracts embedded JPEG/PNG XObject images when no rasterizer is installed on PATH."
        }
      }
    },
    {
      "id": "compress-pdf",
      "domain": "pdf",
      "acceptsKind": "pdf",
      "label": "Compress PDF",
      "blurb": "Lossless: nothing in the document changes.",
      "tagline": "Lossless stream and object compression",
      "description": "Losslessly reduce PDF file sizes using Flate stream re-compression and object stream optimization.",
      "outputCapability": "Losslessly compressed PDF document",
      "searchKeywords": ["compress pdf", "shrink pdf", "reduce pdf", "qpdf", "smaller pdf", "email pdf"],
      "popular": true,
      "inputs": { "mode": "one", "min": 1, "max": null },
      "acceptedFormats": {
        "web": ["pdf"],
        "desktop": ["pdf"]
      },
      "outputFormats": {
        "web": ["pdf"],
        "desktop": ["pdf"]
      },
      "options": [],
      "outputNaming": {
        "template": "{name}_compressed",
        "multi": false,
        "extRule": "fixed",
        "fixedExt": "pdf"
      },
      "limitsKey": "pdf",
      "capabilities": {
        "batch": false,
        "preview": false,
        "loupe": false,
        "passwordUnlock": { "web": true, "desktop": true },
        "chainOutput": true
      },
      "platformSupport": {
        "web": {
          "status": "available",
          "engine": "@neslinesli93/qpdf-wasm"
        },
        "desktop": {
          "status": "available",
          "engine": "builtin",
          "engineLabel": "Rust lopdf",
          "externalDependencies": []
        }
      }
    },
    {
      "id": "convert-audio",
      "domain": "audio",
      "acceptsKind": "audio",
      "label": "Convert audio",
