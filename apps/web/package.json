    "deploy:netlify": "netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@refract/core": "workspace:*",
    "@refract/engine-wasm": "workspace:*",
    "client-zip": "2.5.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cf": "1.0.0-beta.27",
    "vite": "8.3.5"
  }
}
