{
  "name": "@refract/web",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p .",
    "e2e": "playwright test",
    "deploy:cloudflare": "pnpm build && cf deploy ./dist",
