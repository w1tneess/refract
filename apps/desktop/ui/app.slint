import { Button, VerticalBox, HorizontalBox, ScrollView, ComboBox, LineEdit } from "std-widgets.slint";

export struct JobEntry {
    id: int,
    name: string,
    size_text: string,
    tool_label: string,
    status: string,
    error: string,
    output_path: string,
}

global Palette {
    // Refract Dark Mode — WCAG 2.2 AA Graphite + Apple Blue (matches DESIGN.md)
    out property <color> bg: #000000;
    out property <color> surface: #1c1c1e;
    out property <color> surface-raised: #2c2c2e;
    out property <color> surface-hover: #3a3a3c;
    out property <color> hairline: #38383a;
    out property <color> control-border: #76767b;

    out property <color> text: #f5f5f7;
    out property <color> text-soft: #a1a1a6;
    out property <color> text-faint: #98989d;

    out property <color> accent: #0a84ff;
    out property <color> accent-hover: #379cff;
    out property <color> accent-text: #000000;
    out property <color> accent-ink: #70b8ff;

    out property <color> success: #32d74b;
    out property <color> danger: #ff6961;
    out property <color> warn: #ffd60a;
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 36px;
    border-radius: 7px;
    border-width: focus-scope.has-focus ? 2px : 0px;
    border-color: Palette.accent;
    background: root.active
        ? (touch.has-hover ? Palette.accent-hover : Palette.accent)
        : (touch.has-hover ? Palette.surface-raised : transparent);

    animate background { duration: 150ms; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.label;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: start;

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Palette.accent-text : (touch.has-hover ? Palette.text : Palette.text-soft);
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "Refract — Local-First File Converter";
    preferred-width: 920px;
    preferred-height: 660px;
    min-width: 720px;
    min-height: 520px;
    background: Palette.bg;

    callback pick_files();
    callback start_processing();
    callback clear_jobs();
    callback open_output_folder(string);
    callback tool_changed(string);

    in-out property <[string]> tool_list: [
        "Convert image",
        "Compress image",
        "Resize image",
        "Merge PDF",
        "Split PDF",
        "Reorder PDF",
        "Compress PDF",
        "Convert audio",
        "Trim audio"
    ];
    in-out property <string> selected_tool: "Convert image";

    // Options properties
    in-out property <string> opt_image_format: "jpg";
    in-out property <int> opt_image_quality: 85;
    in-out property <string> opt_target_kb: "200";
    in-out property <string> opt_resize_width: "800";
    in-out property <string> opt_resize_height: "0";
    in-out property <string> opt_audio_format: "mp3";
    in-out property <string> opt_audio_bitrate: "192";
    in-out property <string> opt_trim_start: "0";
    in-out property <string> opt_trim_end: "30";
    in-out property <string> opt_pdf_ranges: "1-2";
    in-out property <string> opt_pdf_order: "1, 2";

    // Queue properties
    in-out property <[JobEntry]> jobs: [];
    in-out property <bool> is_running: false;

    HorizontalBox {
        padding: 16px;
        spacing: 16px;

        // Left sidebar: Brand + Tool selection
        Rectangle {
            width: 224px;
            background: Palette.surface;
            border-radius: 13px;
            border-width: 1px;
            border-color: Palette.hairline;

            VerticalBox {
                padding: 12px;
                spacing: 12px;

                VerticalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;

                    Text {
                        text: "refract";
                        font-size: 16px;
                        font-weight: 600;
                        color: Palette.text;
                    }
                    Text {
                        text: "Local file tools";
                        font-size: 11px;
                        color: Palette.text-faint;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.hairline;
                }

                Text {
                    text: "Tools";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.text-soft;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding: 0px;
                        spacing: 4px;
                        for tool in root.tool_list : SidebarItem {
                            label: tool;
                            active: root.selected_tool == tool;
                            clicked => {
                                root.selected_tool = tool;
                                root.tool_changed(tool);
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.hairline;
                }

                Text {
                    text: "Runs locally on this device";
                    font-size: 11px;
                    color: Palette.text-faint;
                    wrap: word-wrap;
                }
            }
        }

        // Right side: Active tool, Options, Dropzone, and Queue
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 12px;

            // Header and active tool title
            VerticalLayout {
                spacing: 4px;

                Text {
                    text: root.selected_tool;
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.text;
                }
                Text {
                    text: "Files stay on this device and process locally with native engines.";
                    font-size: 13px;
                    color: Palette.text-soft;
                    wrap: word-wrap;
                }
            }

            // Tool options panel
            Rectangle {
                background: Palette.surface;
                border-radius: 13px;
                border-width: 1px;
                border-color: Palette.hairline;
                min-height: 56px;

                HorizontalBox {
                    padding: 12px;
                    alignment: start;
                    spacing: 16px;

                    if root.selected_tool == "Convert image" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Format"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        ComboBox {
                            model: ["jpg", "png", "webp"];
                            current-value: root.opt_image_format;
                            selected(val) => { root.opt_image_format = val; }
                        }
                        if root.opt_image_format == "jpg" : HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            Text { text: "Quality (%)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                            LineEdit {
                                text: root.opt_image_quality;
                                width: 72px;
                                edited(val) => {
                                    if val.is-float() {
                                        root.opt_image_quality = val.to-float();
                                    }
                                }
                            }
                        }
                    }

                    if root.selected_tool == "Compress image" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Target size (KB)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_target_kb;
                            width: 88px;
                            edited(val) => { root.opt_target_kb = val; }
                        }
                    }

                    if root.selected_tool == "Resize image" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Width (px)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_resize_width;
                            width: 76px;
                            edited(val) => { root.opt_resize_width = val; }
                        }
                        Text { text: "Height (px, 0 = auto)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_resize_height;
                            width: 76px;
                            edited(val) => { root.opt_resize_height = val; }
                        }
                    }

                    if root.selected_tool == "Convert audio" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Format"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        ComboBox {
                            model: ["mp3", "wav", "m4a", "ogg"];
                            current-value: root.opt_audio_format;
                            selected(val) => { root.opt_audio_format = val; }
                        }
                        Text { text: "Bitrate (kbps)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        ComboBox {
                            model: ["128", "192", "256", "320"];
                            current-value: root.opt_audio_bitrate;
                            selected(val) => { root.opt_audio_bitrate = val; }
                        }
                    }

                    if root.selected_tool == "Trim audio" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Start (sec)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_trim_start;
                            width: 72px;
                            edited(val) => { root.opt_trim_start = val; }
                        }
                        Text { text: "End (sec)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_trim_end;
                            width: 72px;
                            edited(val) => { root.opt_trim_end = val; }
                        }
                    }

                    if root.selected_tool == "Split PDF" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Ranges (e.g. 1-2, 3)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_pdf_ranges;
                            width: 140px;
                            edited(val) => { root.opt_pdf_ranges = val; }
                        }
                    }

                    if root.selected_tool == "Reorder PDF" : HorizontalBox {
                        padding: 0px;
                        spacing: 10px;
                        Text { text: "Page order (e.g. 3, 1, 2)"; font-size: 13px; color: Palette.text-soft; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_pdf_order;
                            width: 140px;
                            edited(val) => { root.opt_pdf_order = val; }
                        }
                    }

                    if root.selected_tool == "Merge PDF" : Text {
                        text: "No settings needed — selected PDFs combine in the order added.";
                        font-size: 13px;
                        color: Palette.text-soft;
                        vertical-alignment: center;
                    }

                    if root.selected_tool == "Compress PDF" : Text {
                        text: "No settings needed — uses lossless stream compression.";
                        font-size: 13px;
                        color: Palette.text-soft;
                        vertical-alignment: center;
                    }
                }
            }

            // Dropzone / file picker card
            Rectangle {
                min-height: 104px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.control-border;
                background: Palette.surface;

                VerticalBox {
                    alignment: center;
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "Add files to queue";
                        font-size: 15px;
                        font-weight: 600;
                        color: Palette.text;
                        horizontal-alignment: center;
                    }
                    HorizontalBox {
                        padding: 0px;
                        alignment: center;
                        Button {
                            text: "Choose files…";
                            clicked => { root.pick_files(); }
                        }
                    }
                }
            }

            // Queue Controls Header
            HorizontalBox {
                padding: 0px;
                alignment: space-between;

                Text {
                    text: "Queue (" + (root.jobs.length == 1 ? "1 file" : root.jobs.length + " files") + ")";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.text;
                    vertical-alignment: center;
                }

                HorizontalBox {
                    padding: 0px;
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: root.is_running ? "Processing…" : "Convert all";
                        primary: true;
                        enabled: root.jobs.length > 0 && !root.is_running;
                        clicked => { root.start_processing(); }
                    }

                    Button {
                        text: "Clear queue";
                        enabled: root.jobs.length > 0 && !root.is_running;
                        clicked => { root.clear_jobs(); }
                    }
                }
            }

            // Queue List View
            Rectangle {
                vertical-stretch: 1;
                border-radius: 13px;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;

                if root.jobs.length == 0 : VerticalBox {
                    alignment: center;
                    padding: 24px;
                    spacing: 6px;

                    Text {
                        text: "No files in the queue yet";
                        font-size: 14px;
                        font-weight: 500;
                        color: Palette.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Choose files above to prepare them for local conversion.";
                        font-size: 13px;
                        color: Palette.text-soft;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.jobs.length > 0 : ScrollView {
                    VerticalBox {
                        padding: 10px;
                        spacing: 8px;

                        for job in root.jobs : Rectangle {
                            min-height: 52px;
                            border-radius: 7px;
                            border-width: 1px;
                            border-color: Palette.hairline;
                            background: Palette.surface-raised;

                            VerticalBox {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalBox {
                                    padding: 0px;
                                    alignment: space-between;
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: job.name;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Palette.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: job.size_text + " · " + job.tool_label;
                                            font-size: 12px;
                                            color: Palette.text-soft;
                                            overflow: elide;
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        alignment: end;
                                        spacing: 8px;

                                        Rectangle {
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: Palette.hairline;
                                            background: Palette.surface;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                padding-top: 4px;
                                                padding-bottom: 4px;
                                                spacing: 6px;
                                                alignment: center;

                                                Rectangle {
                                                    width: 6px;
                                                    height: 6px;
                                                    border-radius: 3px;
                                                    y: (parent.height - self.height) / 2;
                                                    background: job.status == "Done" ? Palette.success
                                                        : (job.status == "Failed" ? Palette.danger
                                                        : (job.status == "Working" ? Palette.accent : Palette.text-faint));
                                                }

                                                Text {
                                                    text: job.status;
                                                    font-size: 12px;
                                                    font-weight: 500;
                                                    color: job.status == "Done" ? Palette.success
                                                        : (job.status == "Failed" ? Palette.danger
                                                        : (job.status == "Working" ? Palette.accent-ink : Palette.text-soft));
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        if job.status == "Done" && job.output_path != "" : Button {
                                            text: "Show in folder";
                                            clicked => { root.open_output_folder(job.output_path); }
                                        }
                                    }
                                }

                                if job.status == "Failed" && job.error != "" : Text {
                                    text: job.error;
                                    font-size: 12px;
                                    color: Palette.danger;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
