import { Button, VerticalBox, HorizontalBox, ScrollView, ComboBox, LineEdit } from "std-widgets.slint";

export struct JobEntry {
    id: int,
    name: string,
    size_text: string,
    tool_label: string,
    status: string,
    error: string,
    output_path: string,
}

export component MainWindow inherits Window {
    title: "Refract — Native File Converter";
    preferred-width: 860px;
    preferred-height: 640px;
    background: #121214;

    callback pick_files();
    callback start_processing();
    callback clear_jobs();
    callback open_output_folder(string);
    callback tool_changed(string);

    in-out property <[string]> tool_list: [
        "Convert image",
        "Compress image",
        "Resize image",
        "Merge PDF",
        "Split PDF",
        "Reorder PDF",
        "Compress PDF",
        "Convert audio",
        "Trim audio"
    ];
    in-out property <string> selected_tool: "Convert image";

    // Options properties
    in-out property <string> opt_image_format: "jpg";
    in-out property <int> opt_image_quality: 85;
    in-out property <string> opt_target_kb: "200";
    in-out property <string> opt_resize_width: "800";
    in-out property <string> opt_resize_height: "0";
    in-out property <string> opt_audio_format: "mp3";
    in-out property <string> opt_audio_bitrate: "192";
    in-out property <string> opt_trim_start: "0";
    in-out property <string> opt_trim_end: "30";
    in-out property <string> opt_pdf_ranges: "1-2";
    in-out property <string> opt_pdf_order: "1, 2";

    // Queue properties
    in-out property <[JobEntry]> jobs: [];
    in-out property <bool> is_running: false;

    HorizontalBox {
        padding: 16px;
        spacing: 16px;

        // Left sidebar: Tool selection
        Rectangle {
            width: 200px;
            background: #18181b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #27272a;

            VerticalBox {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "TOOLS";
                    font-size: 11px;
                    font-weight: 700;
                    color: #71717a;
                }

                ScrollView {
                    VerticalBox {
                        spacing: 4px;
                        for tool in root.tool_list : Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            background: root.selected_tool == tool ? #27272a : transparent;

                            TouchArea {
                                clicked => {
                                    root.selected_tool = tool;
                                    root.tool_changed(tool);
                                }
                            }

                            Text {
                                x: 10px;
                                y: (parent.height - self.height) / 2;
                                text: tool;
                                font-size: 13px;
                                color: root.selected_tool == tool ? #ffffff : #a1a1aa;
                            }
                        }
                    }
                }
            }
        }

        // Right side: Active tool, Options, Dropzone, and Queue
        VerticalBox {
            spacing: 12px;

            // Header and active tool title
            HorizontalBox {
                VerticalBox {
                    spacing: 2px;
                    Text {
                        text: root.selected_tool;
                        font-size: 20px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    Text {
                        text: "Files are processed locally using native high-speed engines";
                        font-size: 12px;
                        color: #71717a;
                    }
                }
            }

            // Tool options panel
            Rectangle {
                background: #18181b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #27272a;
                height: 56px;

                HorizontalBox {
                    padding: 8px;
                    alignment: start;
                    spacing: 16px;

                    if root.selected_tool == "Convert image" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Format:"; color: #d4d4d8; vertical-alignment: center; }
                        ComboBox {
                            model: ["jpg", "png", "webp"];
                            current-value: root.opt_image_format;
                            selected(val) => { root.opt_image_format = val; }
                        }
                        if root.opt_image_format == "jpg" : HorizontalBox {
                            spacing: 6px;
                            Text { text: "Quality:"; color: #d4d4d8; vertical-alignment: center; }
                            LineEdit {
                                text: root.opt_image_quality;
                                width: 60px;
                                edited(val) => {
                                    if val.is-float() {
                                        root.opt_image_quality = val.to-float();
                                    }
                                }
                            }
                        }
                    }

                    if root.selected_tool == "Compress image" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Target Size (KB):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_target_kb;
                            width: 80px;
                            edited(val) => { root.opt_target_kb = val; }
                        }
                    }

                    if root.selected_tool == "Resize image" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Width (px):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_resize_width;
                            width: 70px;
                            edited(val) => { root.opt_resize_width = val; }
                        }
                        Text { text: "Height (px):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_resize_height;
                            width: 70px;
                            edited(val) => { root.opt_resize_height = val; }
                        }
                    }

                    if root.selected_tool == "Convert audio" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Format:"; color: #d4d4d8; vertical-alignment: center; }
                        ComboBox {
                            model: ["mp3", "wav", "m4a", "ogg"];
                            current-value: root.opt_audio_format;
                            selected(val) => { root.opt_audio_format = val; }
                        }
                        Text { text: "Bitrate:"; color: #d4d4d8; vertical-alignment: center; }
                        ComboBox {
                            model: ["128", "192", "256", "320"];
                            current-value: root.opt_audio_bitrate;
                            selected(val) => { root.opt_audio_bitrate = val; }
                        }
                    }

                    if root.selected_tool == "Trim audio" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Start (sec):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_trim_start;
                            width: 60px;
                            edited(val) => { root.opt_trim_start = val; }
                        }
                        Text { text: "End (sec):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_trim_end;
                            width: 60px;
                            edited(val) => { root.opt_trim_end = val; }
                        }
                    }

                    if root.selected_tool == "Split PDF" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Ranges (e.g. 1-2, 3):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_pdf_ranges;
                            width: 120px;
                            edited(val) => { root.opt_pdf_ranges = val; }
                        }
                    }

                    if root.selected_tool == "Reorder PDF" : HorizontalBox {
                        spacing: 8px;
                        Text { text: "Page Order (e.g. 3, 1, 2):"; color: #d4d4d8; vertical-alignment: center; }
                        LineEdit {
                            text: root.opt_pdf_order;
                            width: 120px;
                            edited(val) => { root.opt_pdf_order = val; }
                        }
                    }
                }
            }

            // Dropzone
            Rectangle {
                height: 110px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #3f3f46;
                background: #18181b;

                VerticalBox {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: "Add files to convert";
                        font-size: 15px;
                        font-weight: 600;
                        color: #ffffff;
                        horizontal-alignment: center;
                    }
                    HorizontalBox {
                        alignment: center;
                        Button {
                            text: "Choose Files…";
                            clicked => { root.pick_files(); }
                        }
                    }
                }
            }

            // Queue Controls Header
            HorizontalBox {
                Text {
                    text: "Queue (" + root.jobs.length + " files)";
                    font-size: 14px;
                    font-weight: 600;
                    color: #e4e4e7;
                    vertical-alignment: center;
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: root.is_running ? "Processing…" : "Convert All";
                        primary: true;
                        enabled: root.jobs.length > 0 && !root.is_running;
                        clicked => { root.start_processing(); }
                    }

                    Button {
                        text: "Clear Queue";
                        enabled: root.jobs.length > 0 && !root.is_running;
                        clicked => { root.clear_jobs(); }
                    }
                }
            }

            // Queue List View
            Rectangle {
                border-radius: 8px;
                background: #18181b;
                border-width: 1px;
                border-color: #27272a;

                if root.jobs.length == 0 : VerticalBox {
                    alignment: center;
                    Text {
                        text: "No files in queue. Click 'Choose Files…' above to begin.";
                        font-size: 13px;
                        color: #71717a;
                        horizontal-alignment: center;
                    }
                }

                if root.jobs.length > 0 : ScrollView {
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;

                        for job in root.jobs : Rectangle {
                            min-height: 48px;
                            border-radius: 6px;
                            background: #27272a;

                            VerticalBox {
                                padding: 8px;
                                spacing: 4px;

                                HorizontalBox {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: space-between;

                                    VerticalBox {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: job.name;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: #ffffff;
                                        }
                                        Text {
                                            text: job.size_text + " · " + job.tool_label;
                                            font-size: 11px;
                                            color: #a1a1aa;
                                        }
                                    }

                                    HorizontalBox {
                                        alignment: end;
                                        spacing: 8px;

                                        Text {
                                            text: job.status;
                                            font-size: 12px;
                                            color: job.status == "Done" ? #4ade80 : (job.status == "Failed" ? #f87171 : (job.status == "Working" ? #60a5fa : #a1a1aa));
                                            vertical-alignment: center;
                                        }

                                        if job.status == "Done" && job.output_path != "" : Button {
                                            text: "Show in Folder";
                                            clicked => { root.open_output_folder(job.output_path); }
                                        }
                                    }
                                }

                                if job.status == "Failed" && job.error != "" : Text {
                                    text: job.error;
                                    font-size: 11px;
                                    color: #fca5a5;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
