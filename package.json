{
  "name": "refract",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @refract/web e2e",
    "dev": "pnpm --filter @refract/web dev",
    "build:web": "pnpm --filter @refract/web build",
    "deploy:cloudflare": "pnpm --filter @refract/web deploy:cloudflare",
    "desktop:dev": "cargo run -p refract-desktop",
    "desktop:test": "cargo test --workspace",
    "desktop:check": "cargo check --workspace"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@types/node": "26.6.6"
  }
}
